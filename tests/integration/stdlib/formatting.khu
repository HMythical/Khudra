// How a value renders.
//
// Every number that reaches output goes through the shared formatting helper
// (src/vm/format.h), so this program is the same bytes under `khudra run`,
// `khudra run --native` and a binary from `khudra build`. It is the first
// standard-library golden and the one that pins the float rule.
bring khu::stdlib;

public class Formatting {
    func main() {
        // Signed widths render with their sign, unsigned ones without.
        int8 tiny = -128;
        int16 small = -32768;
        int32 medium = -2147483648;
        int64 wide = -9223372036854775807;
        io.printLine(tiny);
        io.printLine(small);
        io.printLine(medium);
        io.printLine(wide);

        uint8 byteMax = 255;
        uint16 shortMax = 65535;
        uint32 wordMax = 4294967295;
        uint64 longMax = 18446744073709551615;
        io.printLine(byteMax);
        io.printLine(shortMax);
        io.printLine(wordMax);
        io.printLine(longMax);

        // Six significant digits, in whichever of %e and %f is shorter.
        io.printLine(1.5);
        io.printLine(1.0);
        io.printLine(khuStdMath.divide(1.0, 3.0));
        io.printLine(1e20);
        io.printLine(0.000125);

        // Rendering does not distinguish the two float widths -- but the
        // arithmetic does, because a float result is rounded back through 32
        // bits at every step. The same multiplication leaves the 32-bit range
        // and stays inside the 64-bit one.
        float narrow = 1e20;
        dfloat exact = 1e20;
        io.printLine(khuStdMath.multiply(narrow, narrow));
        io.printLine(khuStdMath.multiply(exact, exact));

        io.printLine(true);
        io.printLine(false);
        io.printLine("text");

        // print writes with no separator; printLine adds the newline.
        io.print("a");
        io.print(1);
        io.print(true);
        io.printLine("");
    }
}
