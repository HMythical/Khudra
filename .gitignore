# CMake / build outputs (build/ contains tracked placeholder docs, so scope patterns)
build/CMakeCache.txt
build/CMakeFiles/
build/CMakeScratch/
build/CMakeTmp/
build/cmake_install.cmake
build/Makefile
build/*.cmake
build/cmake-build-*/
# Out-of-source build trees (CI uses build-asan/).
build-*/
cmake-build-*/
build/Testing/
build/generated/
build/khudra
build/khudra[._]*
# Binaries the native build-and-run tests write.
build/native-tests/


# Compiled objects and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.exe

# Khudra bytecode
*.kbc

# Working plans/prompts should not reach the main repo (case-insensitive)
*[pP][lL][aA][nN]*
*[pP][rR][oO][mM][pP][tT]*

# Editor scratch files
*.swp
*.swo
*~
.DS_Store
