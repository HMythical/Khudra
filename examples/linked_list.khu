// A linked-list benchmark, built twice: once on the collected heap and once on
// the manual heap, from the same code shape.
//
// The only difference between the two node classes is the strategy their
// MemoryAllocationTypeObject field selects -- which is the point of Khudra
// choosing memory management through an object rather than through a keyword or
// a compiler flag.
bring khu::stdlib;

public class GcNode {
    public MemoryAllocationTypeObject type = MemoryAllocationTypeObject.setStandard();

    public int64 value = 0;
    public GcNode next = null;
}

public class ManualNode {
    public MemoryAllocationTypeObject type = MemoryAllocationTypeObject.setManual();

    public int64 value = 0;
    public ManualNode next = null;
}

public class LinkedList {
    // Collected: dropping the head is enough, the rest follows.
    public GcNode collected = null;
    // Manual: a managed slot holding a manual reference, so assigning to it
    // pins the node it points at.
    public ManualNode owned = null;

    public int64 rounds = 0;

    // --- the collected list ---

    func buildCollected(int32 count) {
        GcNode head = null;
        int32 i = 0;
        while (i < count) {
            GcNode fresh = GcNode();
            fresh.value = khuStdMath.convertTo(int64, i);
            fresh.next = head;
            head = fresh;
            i = khuStdMath.add(i, 1);
        }
        this.collected = head;
    }

    func sumCollected() -> int64 {
        int64 total = 0;
        GcNode cursor = this.collected;
        while (cursor != null) {
            total = khuStdMath.add(total, cursor.value);
            cursor = cursor.next;
        }
        return total;
    }

    func dropCollected() {
        // Nothing to release: once the head is gone the whole chain is
        // unreachable and the next collection reclaims it.
        this.collected = null;
    }

    // --- the manual list ---

    func buildOwned(int32 count) {
        ManualNode head = null;
        int32 i = 0;
        while (i < count) {
            ManualNode fresh = ManualNode();
            fresh.value = khuStdMath.convertTo(int64, i);
            fresh.next = head;
            head = fresh;
            i = khuStdMath.add(i, 1);
        }
        this.owned = head;
    }

    func sumOwned() -> int64 {
        int64 total = 0;
        ManualNode cursor = this.owned;
        while (cursor != null) {
            total = khuStdMath.add(total, cursor.value);
            cursor = cursor.next;
        }
        return total;
    }

    func dropOwned() {
        // The head is pinned by this.owned, so the pin has to go first --
        // freeing it while the slot still holds it is a runtime error.
        ManualNode cursor = this.owned;
        this.owned = null;
        while (cursor != null) {
            ManualNode next = cursor.next;
            free(cursor);
            cursor = next;
        }
    }

    // --- the benchmark ---

    func round(int32 size) {
        this.buildCollected(size);
        this.buildOwned(size);

        int64 collectedTotal = this.sumCollected();
        int64 ownedTotal = this.sumOwned();
        if (collectedTotal != ownedTotal) {
            io.printLine("MISMATCH: the two lists disagree");
        }

        this.dropCollected();
        this.dropOwned();
        this.rounds = khuStdMath.add(this.rounds, 1);
    }

    func main() {
        int32 size = 500;
        int32 iterations = 0;
        while (iterations < 40) {
            this.round(size);
            iterations = khuStdMath.add(iterations, 1);
        }

        io.print("rounds: ");
        io.printLine(this.rounds);

        // Both lists hold 0..size-1, so each sums to size*(size-1)/2.
        this.buildCollected(size);
        this.buildOwned(size);
        io.print("collected sum: ");
        io.printLine(this.sumCollected());
        io.print("manual sum:    ");
        io.printLine(this.sumOwned());

        this.dropCollected();
        this.dropOwned();
        io.printLine("both lists released");
    }
}
